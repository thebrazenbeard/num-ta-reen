# Source-bound JSON files must have identical bytes on Windows and Linux.
# Their SHA-256 digests are part of the reference-adapter provenance gate.
data/corpus.json text eol=lf
data/lexicon.json text eol=lf

# Frozen synthetic-acoustic research files have SHA-256 custody assertions.
# Enforce their original LF bytes on Windows as well as Unix checkouts.
research/acoustic_v158/*.py text eol=lf

# Preserve the independently reviewed factorial probe/test bytes on Windows.
research/factorial_scope_probe.py text eol=lf
tests/test_factorial_scope_probe.py text eol=lf

# The V176 research record pins raw bytes of all four archived text artifacts.
research/acoustic_v176/* text eol=lf

# Preserve pinned parse-report and cross-lexical research bytes on Windows.
docs/SOURCE_PARSE_REPORT.md text eol=lf
research/crosslex_v183/*.py text eol=lf
research/crosslex_v183/REPORT.md text eol=lf
